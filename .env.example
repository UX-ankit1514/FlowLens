# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Your TinyFish API key (https://agent.tinyfish.ai/api-keys). Optional: you can also
# connect it in the app (Connections). It stays on the server and is never sent to the
# browser. Don't set it on a public deployment unless every visitor should use your balance.
TINYFISH_API_KEY=

# Optional. Enables AI interpretation of reports with Claude (console.anthropic.com).
# Can also be connected in the app (Connections).
# Without it, FlowLens produces an evidence summary built only from what the
# browser agent recorded, and says so in every report.
ANTHROPIC_API_KEY=
